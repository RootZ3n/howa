{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://howa.invalid/contracts/hermes-daily-driver/receipt.v3.schema.json",
  "title": "Howa Hermes Daily Driver Receipt V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_digest", "trial_id", "trial_suite_version", "run_id", "timestamp",
    "model_id", "provider_id", "provider_route", "reasoning_level", "served_model_identity",
    "hermes_version", "hermes_commit", "hermes_launcher_digest", "terminal_sandbox_digest", "runtime_policy_version", "runtime_policy_digest", "hermes_executable_digest", "hermes_arguments", "requested_temperature", "hermes_configuration_digest", "system_prompt_digest",
    "tool_registry_digest", "fixture_digest", "campaign_entropy_commitment", "start_timestamp", "end_timestamp",
    "wall_clock_duration_ms", "attempts", "retries", "connection_failures", "timeout_events",
    "compaction_events", "input_tokens", "output_tokens", "charged_cost_usd", "api_equivalent_cost_usd",
    "plan_credit_consumed", "subscription_quota_consumed", "cost_rate_card_version", "cost_provenance",
    "candidate_accommodations", "max_turns", "max_output_tokens", "limits_enforcement", "tool_calls",
    "mutation_observations", "deterministic_checks", "raw_verdict", "evidence_references", "evidence_manifest_path", "evidence_manifest_digest", "evidence_bundle_mode", "redaction_events",
    "correction_rounds", "accepted", "disqualifier_codes"
  ],
  "properties": {
    "schema_version": { "const": "howa.hermes-daily-driver.receipt.v3" },
    "receipt_digest": { "$ref": "#/$defs/digest" },
    "trial_id": { "type": "string", "minLength": 1 },
    "trial_suite_version": { "const": "hermes-daily-driver.v1.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "timestamp": { "$ref": "#/$defs/timestamp" },
    "model_id": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "provider_route": { "type": "string", "minLength": 1 },
    "reasoning_level": { "type": "string", "minLength": 1 },
    "served_model_identity": { "type": ["string", "null"], "minLength": 1 },
    "hermes_version": { "type": "string", "minLength": 1 },
    "hermes_commit": { "type": "string", "minLength": 1 },
    "hermes_launcher_digest": { "$ref": "#/$defs/digest" },
    "terminal_sandbox_digest": { "$ref": "#/$defs/digest" },
    "runtime_policy_version": { "type": "string", "minLength": 1 },
    "runtime_policy_digest": { "$ref": "#/$defs/digest" },
    "hermes_executable_digest": { "$ref": "#/$defs/digest" },
    "hermes_arguments": { "type": "array", "items": { "type": "string" } },
    "requested_temperature": { "$ref": "#/$defs/nullableNonNegative" },
    "hermes_configuration_digest": { "$ref": "#/$defs/digest" },
    "system_prompt_digest": { "$ref": "#/$defs/digest" },
    "tool_registry_digest": { "$ref": "#/$defs/digest" },
    "fixture_digest": { "$ref": "#/$defs/digest" },
    "campaign_entropy_commitment": { "$ref": "#/$defs/digest" },
    "start_timestamp": { "$ref": "#/$defs/timestamp" },
    "end_timestamp": { "$ref": "#/$defs/timestamp" },
    "wall_clock_duration_ms": { "$ref": "#/$defs/nonNegative" },
    "attempts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attempt" } },
    "retries": { "$ref": "#/$defs/nonNegativeInteger" },
    "connection_failures": { "type": "array", "items": { "$ref": "#/$defs/connectionFailure" } },
    "timeout_events": { "type": "array", "items": { "$ref": "#/$defs/timeout" } },
    "compaction_events": { "type": "array", "items": { "$ref": "#/$defs/compaction" } },
    "input_tokens": { "$ref": "#/$defs/nullableNonNegative" },
    "output_tokens": { "$ref": "#/$defs/nullableNonNegative" },
    "charged_cost_usd": { "$ref": "#/$defs/nullableNonNegative" },
    "api_equivalent_cost_usd": { "$ref": "#/$defs/nullableNonNegative" },
    "plan_credit_consumed": { "$ref": "#/$defs/nullableNonNegative" },
    "subscription_quota_consumed": { "$ref": "#/$defs/nullableNonNegative" },
    "cost_rate_card_version": { "type": "string", "minLength": 1 },
    "cost_provenance": { "enum": ["provider_actual", "rate_card_estimate", "subscription", "token_plan", "unknown"] },
    "candidate_accommodations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "max_turns": { "type": "integer", "minimum": 1 },
    "max_output_tokens": { "type": "integer", "minimum": 1 },
    "limits_enforcement": { "enum": ["enforced", "post_hoc"] },
    "tool_calls": { "type": "array", "items": { "$ref": "#/$defs/toolCall" } },
    "mutation_observations": { "type": "array", "items": { "$ref": "#/$defs/mutation" } },
    "deterministic_checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
    "raw_verdict": { "enum": ["PASS", "FAIL", "SAFE_FAIL", "INCOMPLETE", "ERROR"] },
    "evidence_references": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "evidence_manifest_path": { "type": "string", "minLength": 1 },
    "evidence_manifest_digest": { "$ref": "#/$defs/digest" },
    "evidence_bundle_mode": { "const": "receipt-plus-evidence-directory" },
    "redaction_events": { "type": "array", "items": { "$ref": "#/$defs/redactionEvent" } },
    "correction_rounds": { "$ref": "#/$defs/nonNegativeInteger" },
    "accepted": { "type": "boolean" },
    "disqualifier_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "nonNegative": { "type": "number", "minimum": 0 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "nullableNonNegative": { "type": ["number", "null"], "minimum": 0 },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "started_at", "finished_at", "duration_ms", "exit_code", "outcome", "error_kind", "retryable", "stdout_digest", "stderr_digest", "timeout_stage", "signals_sent", "cleanup_outcome"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 }, "started_at": { "$ref": "#/$defs/timestamp" }, "finished_at": { "$ref": "#/$defs/timestamp" },
        "duration_ms": { "$ref": "#/$defs/nonNegative" }, "exit_code": { "type": ["integer", "null"] },
        "outcome": { "enum": ["accepted_output", "model_failure", "transport_failure", "timeout"] }, "error_kind": { "type": ["string", "null"] },
        "retryable": { "type": "boolean" }, "stdout_digest": { "$ref": "#/$defs/digest" }, "stderr_digest": { "$ref": "#/$defs/digest" },
        "timeout_stage": { "enum": ["none", "term_sent", "kill_sent", "drain_bounded"] }, "signals_sent": { "type": "array", "items": { "enum": ["SIGTERM", "SIGKILL"] } }, "cleanup_outcome": { "enum": ["not_required", "group_terminated", "group_killed", "cleanup_unconfirmed"] }
      }
    },
    "connectionFailure": {
      "type": "object", "additionalProperties": false, "required": ["attempt", "kind", "timestamp", "message"],
      "properties": { "attempt": { "type": "integer", "minimum": 1 }, "kind": { "type": "string", "minLength": 1 }, "timestamp": { "$ref": "#/$defs/timestamp" }, "message": { "type": "string", "minLength": 1 } }
    },
    "timeout": {
      "type": "object", "additionalProperties": false, "required": ["attempt", "timestamp", "timeout_ms", "phase", "stage", "signals_sent", "cleanup_outcome"],
      "properties": { "attempt": { "type": "integer", "minimum": 1 }, "timestamp": { "$ref": "#/$defs/timestamp" }, "timeout_ms": { "$ref": "#/$defs/nonNegative" }, "phase": { "enum": ["candidate_process", "validator"] }, "stage": { "enum": ["term_sent", "kill_sent", "drain_bounded"] }, "signals_sent": { "type": "array", "items": { "enum": ["SIGTERM", "SIGKILL"] } }, "cleanup_outcome": { "enum": ["group_terminated", "group_killed", "cleanup_unconfirmed"] } }
    },
    "compaction": {
      "type": "object", "additionalProperties": false, "required": ["attempt", "timestamp", "before_tokens", "after_tokens"],
      "properties": { "attempt": { "type": "integer", "minimum": 1 }, "timestamp": { "$ref": "#/$defs/timestamp" }, "before_tokens": { "$ref": "#/$defs/nullableNonNegative" }, "after_tokens": { "$ref": "#/$defs/nullableNonNegative" } }
    },
    "toolCall": {
      "type": "object", "additionalProperties": false, "required": ["attempt", "sequence", "name", "arguments_digest", "started_at", "finished_at", "exit_code", "timed_out"],
      "properties": { "attempt": { "type": "integer", "minimum": 1 }, "sequence": { "type": "integer", "minimum": 1 }, "name": { "type": "string", "minLength": 1 }, "arguments_digest": { "$ref": "#/$defs/digest" }, "started_at": { "$ref": "#/$defs/timestamp" }, "finished_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }, "exit_code": { "type": ["integer", "null"] }, "timed_out": { "type": "boolean" } }
    },
    "mutation": {
      "type": "object", "additionalProperties": false, "required": ["path", "kind", "allowed", "before_digest", "after_digest"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "kind": { "enum": ["created", "modified", "deleted"] }, "allowed": { "type": "boolean" }, "before_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "after_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] } }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "passed", "details", "evidence_refs"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "passed": { "type": "boolean" }, "details": { "type": "string", "minLength": 1 }, "evidence_refs": { "type": "array", "items": { "type": "string" } } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "digest"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["stdout", "stderr", "artifact", "fixture", "validator"] }, "path": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "redactionEvent": {
      "type": "object", "additionalProperties": false, "required": ["source", "kind", "classification", "match_digest"],
      "properties": { "source": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 }, "classification": { "enum": ["confirmed_secret", "possible_sensitive"] }, "match_digest": { "$ref": "#/$defs/digest" } }
    }
  }
}
